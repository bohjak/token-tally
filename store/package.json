{
  "name": "@token-tally/store",
  "version": "0.1.0",
  "description": "Central store writer library and CLI for ToTally",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bohjak/token-tally.git",
    "directory": "store"
  },
  "homepage": "https://github.com/bohjak/token-tally#readme",
  "bugs": {
    "url": "https://github.com/bohjak/token-tally/issues"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "bin": {
    "token-tally": "./bin/token-tally.js"
  },
  "scripts": {
    "gen:pricing": "pnpm -w exec tsx scripts/generate-pricing.ts",
    "build": "pnpm gen:pricing && tsc",
    "build:sea": "pnpm gen:pricing && tsc && node scripts/build-sea.mjs",
    "typecheck": "pnpm gen:pricing && tsc --noEmit",
    "test": "node --test 'tests/**/*.test.js' 'dist/cli/tests/**/*.test.js'"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.5.0"
  }
}
