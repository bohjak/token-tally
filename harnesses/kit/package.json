{
  "name": "@token-tally/harness-kit",
  "version": "0.1.0",
  "description": "Shared scaffolding for ToTally hook-process writers",
  "private": true,
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "prebuild": "pnpm -F @token-tally/store build",
    "build": "tsc",
    "pretypecheck": "pnpm -F @token-tally/store build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "node --test 'dist/tests/**/*.test.js'"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@token-tally/store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  }
}
