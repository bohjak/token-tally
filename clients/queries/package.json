{
  "name": "@token-tally/queries",
  "version": "0.1.0",
  "description": "Shared read-only SQLite query layer for @token-tally readers",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
