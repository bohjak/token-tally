{
  "name": "@token-tally/web-explorer",
  "version": "0.1.0",
  "description": "Local web explorer for ToTally analytics",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch server/index.ts --port 3741 --no-open",
    "dev:client": "vite",
    "build": "pnpm build:server && pnpm build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "node --test 'dist/server/tests/**/*.test.js'"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@token-tally/queries": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "hono": "^4.6.0",
    "open": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "recharts": "^2.13.0",
    "@tanstack/react-table": "^8.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
